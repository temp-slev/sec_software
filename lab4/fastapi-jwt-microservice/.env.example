# Скопируйте в .env и задайте свои значения. Без SECRET_KEY приложение не запустится.
# Сгенерировать ключ: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
MAX_SESSION_DAYS=30
ADMIN_CODE=change-me-too
ALLOWED_ORIGINS=http://localhost:3000
