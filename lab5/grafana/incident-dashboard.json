{
 "uid": "incident-investigation",
 "title": "Incident Investigation Dashboard",
 "tags": [
  "lab5"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "10s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "title": "Топ ошибок по подам (ERROR за выбранный период)",
   "type": "bargauge",
   "datasource": "Loki",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (pod) (count_over_time({app=\"fastapi-app\"} | json | level=\"ERROR\" [$__range]))",
     "datasource": "Loki"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "orientation": "horizontal",
    "displayMode": "gradient"
   }
  },
  {
   "id": 2,
   "title": "Временная шкала ошибок 5xx (Prometheus)",
   "type": "timeseries",
   "datasource": "Prometheus",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(http_requests_total{status=~\"5..\"}[1m]))",
     "datasource": "Prometheus",
     "legendFormat": "5xx/с"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 3,
   "title": "Запросы и ошибки (Prometheus) + логи ошибок (Loki)",
   "type": "timeseries",
   "datasource": "Prometheus",
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 24,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(http_requests_total[1m]))",
     "datasource": "Prometheus",
     "legendFormat": "Все запросы/с"
    },
    {
     "refId": "B",
     "expr": "sum(rate(http_requests_total{status=~\"5..\"}[1m]))",
     "datasource": "Prometheus",
     "legendFormat": "Ошибки 5xx/с"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 4,
   "title": "Последние логи ошибок",
   "type": "logs",
   "datasource": "Loki",
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 24,
    "h": 9
   },
   "targets": [
    {
     "refId": "A",
     "expr": "{app=\"fastapi-app\"} | json | level=\"ERROR\"",
     "datasource": "Loki"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "showTime": true,
    "wrapLogMessage": true,
    "sortOrder": "Descending",
    "enableLogDetails": true
   }
  },
  {
   "id": 5,
   "title": "CPU подов fastapi-app",
   "type": "timeseries",
   "datasource": "Prometheus",
   "gridPos": {
    "x": 0,
    "y": 25,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{pod=~\"fastapi-app.*\"}[1m]))",
     "datasource": "Prometheus",
     "legendFormat": "{{pod}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 6,
   "title": "Память подов fastapi-app",
   "type": "timeseries",
   "datasource": "Prometheus",
   "gridPos": {
    "x": 12,
    "y": 25,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (pod) (container_memory_working_set_bytes{pod=~\"fastapi-app.*\"})",
     "datasource": "Prometheus",
     "legendFormat": "{{pod}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 7,
   "title": "Латентность запросов p95",
   "type": "timeseries",
   "datasource": "Prometheus",
   "gridPos": {
    "x": 0,
    "y": 33,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket[1m])))",
     "datasource": "Prometheus",
     "legendFormat": "p95"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 8,
   "title": "Объём логов (строк/с)",
   "type": "timeseries",
   "datasource": "Loki",
   "gridPos": {
    "x": 12,
    "y": 33,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate({app=\"fastapi-app\"}[1m]))",
     "datasource": "Loki",
     "legendFormat": "строк/с",
     "queryType": "range"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {}
  }
 ]
}