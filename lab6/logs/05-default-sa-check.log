$ kubectl get secrets -n default
No resources found in default namespace.

# В современных версиях Kubernetes (1.24+) токен для default SA не создаётся автоматически;
# секрет-токен можно получить только явным запросом через TokenRequest API:
$ kubectl create token default -n default
eyJhbGciOiJSUzI1NiIsImtpZCI6InVVNlRkOUl4TkpIZmJOT3JqcUhtc1l2

$ kubectl --token=<токен default SA> auth can-i create pods
yes
$ kubectl --token=<токен default SA> auth can-i list secrets -A
yes
$ kubectl --token=<токен default SA> auth can-i --list
